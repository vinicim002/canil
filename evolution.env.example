# Copie para evolution.env e ajuste se necessário:
# cp evolution.env.example evolution.env

AUTHENTICATION_API_KEY=canil-evolution-dev-key
SERVER_URL=http://localhost:8081
SERVER_PORT=8080

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:evolution_pass@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=canil_evolution

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0

# Instância padrão criada pelo script scripts/evolution-setup.sh
EVOLUTION_INSTANCE_NAME=canil
