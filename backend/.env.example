# Copie para variáveis no Railway (ou export local com profile prod).
# Nunca commite valores reais.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL — linke o serviço Postgres no Railway (Reference Variables)
# Aceita DATABASE_URL, DB_URL ou PGHOST/PGPORT/PGUSER/PGPASSWORD

# JWT — gere com: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=28800000
JWT_REFRESH_EXPIRATION=604800000

# CORS — URL do front na Vercel (sem barra final)
CORS_ALLOWED_ORIGINS=https://seu-dominio.vercel.app

# Site
MAIL_SITE_URL=https://seu-dominio.vercel.app
VISITA_SITE_URL=https://seu-dominio.vercel.app
VISITA_WHATSAPP_SITE_URL=https://seu-dominio.vercel.app

# E-mail — produção (escolha um)
# Gmail SMTP (sem domínio): docs/GMAIL-SMTP-RAILWAY.md
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
MAIL_FROM=seu@gmail.com
MAIL_ADMIN=seu@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu@gmail.com
MAIL_PASSWORD=<senha-de-app-google>

# Resend (com domínio verificado): docs/RESEND.md
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# n8n
N8N_ENABLED=true
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_URL_VISITA=https://seu-n8n.app/webhook/canil-visita-eventos
N8N_WEBHOOK_URL_FILHOTE=https://seu-n8n.app/webhook/canil-filhote-resposta

# Evolution API — ver docs/EVOLUTION-PROD.md (serviço separado no Railway)
EVOLUTION_ENABLED=true
EVOLUTION_BASE_URL=https://sua-evolution.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=canil
EVOLUTION_READ_TIMEOUT_MS=60000
N8N_VISITA_VIA_EVOLUTION=true
N8N_FILHOTE_VIA_N8N=false

# Canil
CANIL_WHATSAPP_NUMERO=5521XXXXXXXXX
CANIL_DOCS_BASE_URL=https://sua-api.railway.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
